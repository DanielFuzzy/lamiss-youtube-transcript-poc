{
  "name": "lamiss-youtube-transcript-poc",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "package:staging": "node scripts/package.js --env staging",
    "package:production": "node scripts/package.js --env production",
    "phase3:verify": "npm run build && node scripts/phase3-verify.js",
    "package:store-draft": "node scripts/package.js --env store-draft"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "playwright": "^1.63.0",
    "typescript": "5.4.5"
  }
}
