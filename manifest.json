{
  "manifest_version": 3,
  "name": "Lamiss",
  "version": "0.1.0",
  "description": "Practice a language while you watch YouTube: Lamiss asks you questions about the video and answers yours, by voice or text.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "scripting",
    "webRequest",
    "storage",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lamiss",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "chat/chat.html",
        "brand/lamiss-mark-small.svg"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared/lamiss-config.js",
        "shared/lamiss-api.js",
        "content/youtube.js"
      ],
      "css": [
        "content/lamiss-button.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
