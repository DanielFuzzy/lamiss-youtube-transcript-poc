{
  "manifest_version": 3,
  "name": "Lamiss YouTube Transcript POC",
  "version": "0.1.0",
  "description": "Investigates extracting YouTube caption data from the browser for a Lamiss transcript POC.",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lamiss Transcript POC",
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "chat/chat.html"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared/lamiss-api.js",
        "content/youtube.js"
      ],
      "css": [
        "content/lamiss-button.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
